# Server port
PORT=5000
# Use development locally; production requires HTTPS and secure cookies.
NODE_ENV=development

# MongoDB connection string. Never commit a real URI or password.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/rankhire?retryWrites=true&w=majority
# Long random value used to sign session cookies. Generate a unique value per environment.
SESSION_SECRET=replace-with-a-long-random-secret

# Exact browser origins allowed to make credentialed API requests. Separate multiple origins with commas.
CLIENT_URL=http://localhost:5173

# Gmail IMAP server hostname
MAIL_IMAP_HOST=imap.gmail.com
# Gmail IMAP SSL port
MAIL_IMAP_PORT=993
# Use a secure IMAP connection
MAIL_IMAP_SECURE=true
# Placement cell Gmail address
MAIL_USER=your-placement-cell@gmail.com
# Gmail app password (not your normal password)
MAIL_APP_PASSWORD=your-16-character-app-password
# Gmail mailbox to read
MAIL_FOLDER=INBOX
# Maximum recent messages to show
MAIL_FETCH_LIMIT=20

# Optional Python command overrides for resume/marksheet extraction.
PYTHON_COMMAND=py
PYTHON_BIN=py
